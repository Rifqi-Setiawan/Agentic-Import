# ImporJaga Environment Configuration Template
APP_ENV=development
APP_PORT=8120
APP_HOST=127.0.0.1
DATABASE_URL=postgresql://imporjaga_user:PASSWORD@127.0.0.1:5432/imporjaga
TEST_DATABASE_URL=postgresql://imporjaga_user:PASSWORD@127.0.0.1:5432/imporjaga_test

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_OUTPUT_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage
STORAGE_VAULT_PATH=/srv/hermes-control/services/agentic-import/data/vault
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3060","http://127.0.0.1:3060","https://imporjaga.rifqisetiawan.my.id"]

# LLM Gateway & Privacy Policy
# 'redacted_dev_router' enables local 9Router for development
# 'paid_or_local_only' restricts calls strictly to official metered APIs or local offline models
LLM_DATA_POLICY=redacted_dev_router
LLM_GATEWAY_URL=http://127.0.0.1:20128/v1
LLM_GATEWAY_KEY=
LLM_MODEL=ag/gemini-3.8-flash-high
LLM_TEMPERATURE=0.0

# SMTP Simulation / Relay Settings
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
AGENT_EMAIL_ALLOWED_RECIPIENTS=["tim-impor@mitrakemas.co.id","rifqi@rifqisetiawan.my.id"]
FOLLOWUP_DELAY_MINUTES=3
